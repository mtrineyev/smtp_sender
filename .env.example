# Параметри підключення до SMTP
SMTP_SERVER=smtp.eu.mailgun.org
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Дані відправника
SENDER_NAME=HearMeTech
SENDER_EMAIL=info@hearme.tech

# Прихована копія (BCC). Якщо не потрібна, залиште порожнім: BCC_EMAIL=
BCC_EMAIL=

# Тема листа за замовчуванням (підтримує змінні, наприклад {{ name }})
DEFAULT_SUBJECT=Інформація від HearMe

# Загальні файли для всіх (через крапку з комою; залиште порожнім, якщо немає)
COMMON_ATTACHMENTS=

# Затримка між листами в секундах
SEND_DELAY_SECONDS=2.0
